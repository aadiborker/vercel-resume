# Resend (server-side only — never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Upstash Redis (server-side only — used for contact form rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical site URL for sitemap / Open Graph (optional; falls back to data/resume.ts siteUrl)
SITE_URL=
